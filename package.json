{
  "name": "@strobelabs/perpcity-sdk",
  "author": "Strobe Labs",
  "description": "TypeScript SDK for interacting with Perp City contracts",
  "version": "0.19.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StrobeLabs/perpcity-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js",
      "require": "./dist/abis.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "import": "./dist/functions.js",
      "require": "./dist/functions.cjs"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js",
      "require": "./dist/math.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.e2e.config.ts --no-file-parallelism --sequence.concurrent=false",
    "test:chain": "vitest run --config vitest.e2e.config.ts src/__tests__/integration/fairPrice.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gen:vectors": "tsx scripts/gen-economics-vectors.ts",
    "ci": "pnpm run build && pnpm run test:unit && pnpm exec tsc --noEmit && pnpm run lint",
    "example-create-perp": "tsx -r dotenv/config examples/create-perp.ts",
    "example-maker": "tsx -r dotenv/config examples/maker.ts",
    "example-taker": "tsx -r dotenv/config examples/taker.ts",
    "example-close": "tsx -r dotenv/config examples/close.ts",
    "example-view": "tsx -r dotenv/config examples/view.ts",
    "example-optimized": "tsx -r dotenv/config examples/optimized-view.ts"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/node": "^24.5.2",
    "@vitest/ui": "^4.1.12",
    "dotenv": "^17.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^1.4.1",
    "@uniswap/v3-sdk": "^3.25.2",
    "viem": "^2.46.1"
  },
  "pnpm": {
    "overrides": {
